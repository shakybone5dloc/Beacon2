{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd backend && .\\mvnw.cmd spring-boot:run"],
      "port": 8080,
      "autoPort": false
    },
    {
      "name": "api (testcontainers db)",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd backend && .\\mvnw.cmd spring-boot:test-run"],
      "port": 8080
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "start"],
      "port": 4200
    }
  ]
}
