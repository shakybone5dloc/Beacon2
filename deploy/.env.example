# Copy to .env on the server (next to compose.yaml) and fill in. Never commit .env.

# The database password. Anything long and random; only the containers use it.
POSTGRES_PASSWORD=

# Encrypts the API keys users save. Use the SAME value as your PC's .env so keys you've
# already saved keep working after the data moves over.
BEACON_SECRET_KEY=

# Where you open Beacon, for links in emails: your server's Tailscale name.
BEACON_APP_URL=https://server.your-tailnet.ts.net

# The weekly email (Resend works; see the main .env).
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM=Beacon <onboarding@resend.dev>

# Who can make invite codes (Settings · Invites): your own sign-in email. Comma-separated.
BEACON_ADMIN_EMAILS=

# Optional
# Signing up needs an invite code while this is true (the default).
# BEACON_INVITE_ONLY=true
# Sign-in and sign-up limits: attempts per address per 15 minutes, wrong passwords per account
# per 15 minutes before it's locked for the rest of that time, and sign-ups per address per hour.
# BEACON_LOGIN_PER_IP=30
# BEACON_LOGIN_FAILURES_PER_ACCOUNT=8
# BEACON_REGISTER_PER_IP=10
# BEACON_DISABLED_SOURCES=adzuna
# BEACON_PORT=8790
# BACKUP_KEEP_DAYS=14
# BEACON_TAG=latest
