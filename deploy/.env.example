# Copy to .env on the server (next to compose.yaml) and fill in. Never commit .env.

# The database password. Anything long and random; only the containers use it.
POSTGRES_PASSWORD=

# Encrypts the API keys users save. Use the SAME value as your PC's .env so keys you've
# already saved keep working after the data moves over.
BEACON_SECRET_KEY=

# Where you open Beacon, for links in emails: your server's Tailscale name.
BEACON_APP_URL=https://server.your-tailnet.ts.net

# The weekly email (Resend works; see the main .env).
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM=Beacon <onboarding@resend.dev>

# Optional
# BEACON_DISABLED_SOURCES=adzuna
# BEACON_PORT=8790
# BACKUP_KEEP_DAYS=14
# BEACON_TAG=latest
